{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Tempo",
  "version": "0.1.0",
  "identifier": "com.tempo.gitviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Git Tempo", "width": 1320, "height": 820, "minWidth": 900, "minHeight": 600, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
